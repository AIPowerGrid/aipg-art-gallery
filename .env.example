# ===========================================
# AIPG Art Gallery - Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values

# ===========================================
# Frontend Configuration
# ===========================================

# Gallery API endpoint (your Go backend)
NEXT_PUBLIC_GALLERY_API=http://localhost:4000/api

# Supabase Configuration (Optional - for persistent gallery storage)
# Create a free project at https://supabase.com/
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# WalletConnect Project ID (Required for wallet connections)
# Get yours free at https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ===========================================
# Go Backend Configuration
# ===========================================

# Server address
GALLERY_SERVER_ADDR=:4000

# CORS allowed origins (comma-separated)
GALLERY_ALLOWED_ORIGINS=http://localhost:3000

# ===========================================
# AIPG Grid API Configuration
# ===========================================

# Grid API endpoint
AIPG_API_URL=https://api.aipowergrid.io/api/v2

# Client identifier
AIPG_CLIENT_AGENT=AIPG-Art-Gallery:v2

# Grid API key (public key for job submission)
AIPG_API_KEY=

# Target specific worker ID (optional - leave empty to use any available worker)
TARGET_WORKER_ID=

# ===========================================
# Model Configuration
# ===========================================

# Path to model presets JSON file
MODEL_PRESETS_PATH=./server/config/model_presets.json

# ===========================================
# Blockchain Configuration (Base Mainnet)
# ===========================================

# ModelVault - on-chain model registry
MODELVAULT_ENABLED=true
MODELVAULT_RPC_URL=https://mainnet.base.org
MODELVAULT_CONTRACT=0x79F39f2a0eA476f53994812e6a8f3C8CFe08c609

# RecipeVault - on-chain workflow registry (same diamond proxy)
RECIPESVAULT_ENABLED=true
RECIPESVAULT_RPC_URL=https://mainnet.base.org
RECIPESVAULT_CONTRACT=0x79F39f2a0eA476f53994812e6a8f3C8CFe08c609

# ===========================================
# Authentication
# ===========================================

# JWT secret for signing tokens (generate with: openssl rand -base64 32)
JWT_SECRET=

# ===========================================
# Database (PostgreSQL)
# ===========================================

# PostgreSQL connection string (required for gallery storage)
# Format: host=localhost port=5432 user=YOUR_USER password=YOUR_PASSWORD dbname=aipg_gallery sslmode=disable
POSTGRES_CONN_STR=
POSTGRES_ENABLED=true