# ===========================================
# AIPG Art Gallery - Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values

# ===========================================
# Frontend Configuration
# ===========================================

# Gallery API endpoint (your Go backend)
NEXT_PUBLIC_GALLERY_API=http://localhost:4000/api

# Legacy direct-Supabase frontend settings (unused by the Go production path)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# WalletConnect Project ID (Required for wallet connections)
# Get yours free at https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ===========================================
# Go Backend Configuration
# ===========================================

# Server address
GALLERY_SERVER_ADDR=:4000

# CORS allowed origins (comma-separated)
GALLERY_ALLOWED_ORIGINS=http://localhost:3000

# ===========================================
# AIPG Grid API Configuration
# ===========================================

# Grid API endpoint
AIPG_API_URL=https://api.aipowergrid.io/v1

# Client identifier
AIPG_CLIENT_AGENT=AIPG-Art-Gallery:v3

# Server-only Grid service key. Required scopes: account.read,
# inference.submit, identity.exchange, identity.assert. Bind it to the
# aipg-art service client and configure service spending ceilings in Core.
# Never expose this key in browser code.
AIPG_API_KEY=

# Text model for prompt enhancement. "auto" lets Core select an online model.
AI_MODEL=auto

# Target specific worker ID (optional - leave empty to use any available worker)
TARGET_WORKER_ID=

# ===========================================
# Model Configuration
# ===========================================

# Path to model presets JSON file (from repo root: ./server/config/...;
# from server/ when using cd server && go run: ./config/model_presets.json)
MODEL_PRESETS_PATH=./server/config/model_presets.json

# Optional create-page model/dimension config override. The server discovers
# repo-root config/styles.json in normal root and server/ working directories.
STYLES_CONFIG_PATH=

# ===========================================
# Blockchain Configuration (Base Mainnet)
# ===========================================

# ModelVault - on-chain model registry
MODELVAULT_ENABLED=true
MODELVAULT_RPC_URL=https://mainnet.base.org
MODELVAULT_CONTRACT=0x79F39f2a0eA476f53994812e6a8f3C8CFe08c609

# RecipeVault - on-chain workflow registry (same diamond proxy). Keep disabled
# until its checkpoint names are migrated to canonical public Grid aliases;
# enabling it currently makes the vault an allowlist for the create-page catalog.
RECIPESVAULT_ENABLED=false
RECIPESVAULT_RPC_URL=https://mainnet.base.org
RECIPESVAULT_CONTRACT=0x79F39f2a0eA476f53994812e6a8f3C8CFe08c609

# ===========================================
# Authentication
# ===========================================

# JWT secret for signing tokens (generate with: openssl rand -base64 32)
# REQUIRED: both the Go server and the Next.js /auth-api routes sign/verify with
# this. There is no fallback — auth fails closed if it is unset.
JWT_SECRET=

# Session cookie (the JWT is delivered as an httpOnly cookie, never to JS).
# AUTH_COOKIE_DOMAIN: set in prod so the web app + API subdomains share the cookie,
#   e.g. ".aipg.art". Leave blank for local dev (host-only cookie).
# AUTH_COOKIE_SECURE: leave false locally; the servers also auto-enable Secure for
#   HTTPS requests (TLS or X-Forwarded-Proto: https). Set true to force it.
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false

# ===========================================
# Google OAuth (Optional - for Google One Tap sign-in)
# ===========================================

# Get your Client ID from Google Cloud Console:
# 1. Go to https://console.cloud.google.com/auth/clients
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add your domain to Authorized JavaScript origins
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ===========================================
# Database (PostgreSQL)
# ===========================================

# PostgreSQL connection string (required for gallery storage)
# Format: host=localhost port=5432 user=YOUR_USER password=YOUR_PASSWORD dbname=aipg_gallery sslmode=disable
POSTGRES_CONN_STR=
POSTGRES_ENABLED=true
