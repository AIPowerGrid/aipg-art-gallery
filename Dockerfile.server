FROM golang:1.26.9-alpine@sha256:3082400e369fa24d5fc60bca20edab3f6d604e0c5a690ec66b295eff4dd87ade AS builder

WORKDIR /app

RUN apk add --no-cache git

# Resolve only the reviewed lock state before copying source.
COPY server/go.mod server/go.sum ./
RUN go mod download && go mod verify

COPY server/ ./

RUN CGO_ENABLED=0 GOOS=linux go build -mod=readonly -trimpath \
    -ldflags="-s -w" -o /app/api ./cmd/api

FROM alpine:latest@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b

RUN apk --no-cache add ca-certificates \
    && addgroup -S -g 10001 aipg \
    && adduser -S -D -H -u 10001 -G aipg aipg \
    && mkdir -p /app/data \
    && chown aipg:aipg /app/data

WORKDIR /app

COPY --from=builder --chown=aipg:aipg /app/api .
COPY --from=builder --chown=aipg:aipg /app/config ./config
COPY --chown=aipg:aipg config/styles.json ./config/styles.json

EXPOSE 4000

USER aipg:aipg

CMD ["./api"]

